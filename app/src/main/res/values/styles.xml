<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Quill" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/side</item>
        <item name="android:statusBarColor">@color/side</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FFECEAE3</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
    </style>
    <string name="widget_desc">Quill Desktop sessions that are waiting for you</string>
    <color name="bg">#FF262624</color>
    <color name="side">#FF1F1F1D</color>
    <color name="accent">#FFD97757</color>
</resources>
