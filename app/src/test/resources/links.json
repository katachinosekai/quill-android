{
 "version": 1,
 "about": "Shared link detection cases for Quill Desktop (cmd/quill/links_test.go) and Quill Android (LinksTest). Rules: docs/design/phone-links.md section 3. Each case: the item text and every link found in it, in order. start/end: the tappable span as Unicode code point offsets into text (end exclusive); text: that span. kind: web | file | path | other. target: web/other: the URL as written; file: the percent-decoded absolute path; path: the path as written (with ~, without the line hint). label: the Markdown link label. line/lineEnd: a :N, :N-M or :N:C hint (paths only). Absent fields mean empty or 0. Changing this file needs a new docs/phone-links-cases.sha256.",
 "cases": [
  {
   "name": "bare web link, trailing dot dropped",
   "text": "Open https://login.example.com/a/gb77 now.",
   "links": [
    {
     "kind": "web",
     "start": 5,
     "end": 37,
     "text": "https://login.example.com/a/gb77",
     "target": "https://login.example.com/a/gb77"
    }
   ]
  },
  {
   "name": "bold around a URL",
   "text": "see **https://x.io/a**",
   "links": [
    {
     "kind": "web",
     "start": 6,
     "end": 20,
     "text": "https://x.io/a",
     "target": "https://x.io/a"
    }
   ]
  },
  {
   "name": "URL in parentheses",
   "text": "(https://x.io/p)",
   "links": [
    {
     "kind": "web",
     "start": 1,
     "end": 15,
     "text": "https://x.io/p",
     "target": "https://x.io/p"
    }
   ]
  },
  {
   "name": "URL in inline code is not a link",
   "text": "run `curl https://x.io` first",
   "links": []
  },
  {
   "name": "Markdown link and angle autolink",
   "text": "[docs](https://x.io/d) and <https://x.io/e>",
   "links": [
    {
     "kind": "web",
     "start": 0,
     "end": 22,
     "text": "[docs](https://x.io/d)",
     "target": "https://x.io/d",
     "label": "docs"
    },
    {
     "kind": "web",
     "start": 27,
     "end": 43,
     "text": "<https://x.io/e>",
     "target": "https://x.io/e"
    }
   ]
  },
  {
   "name": "file URL is percent-decoded",
   "text": "file:///tmp/a%20b.png, ok",
   "links": [
    {
     "kind": "file",
     "start": 0,
     "end": 21,
     "text": "file:///tmp/a%20b.png",
     "target": "/tmp/a b.png"
    }
   ]
  },
  {
   "name": "absolute path, trailing dot dropped",
   "text": "edited /home/user/Projects/demo/main.go.",
   "links": [
    {
     "kind": "path",
     "start": 7,
     "end": 39,
     "text": "/home/user/Projects/demo/main.go",
     "target": "/home/user/Projects/demo/main.go"
    }
   ]
  },
  {
   "name": "home path with a line hint",
   "text": "see ~/notes/todo.md:12",
   "links": [
    {
     "kind": "path",
     "start": 4,
     "end": 22,
     "text": "~/notes/todo.md:12",
     "target": "~/notes/todo.md",
     "line": 12
    }
   ]
  },
  {
   "name": "fractions, and/or and a lone slash are not paths",
   "text": "and/or 1/2 /",
   "links": []
  },
  {
   "name": "one-line fence is code",
   "text": "```fenced /home/user/x```",
   "links": []
  },
  {
   "name": "Markdown link to a path",
   "text": "[the plan](/home/user/Projects/demo/PLAN.md)",
   "links": [
    {
     "kind": "path",
     "start": 0,
     "end": 44,
     "text": "[the plan](/home/user/Projects/demo/PLAN.md)",
     "target": "/home/user/Projects/demo/PLAN.md",
     "label": "the plan"
    }
   ]
  },
  {
   "name": "other scheme in a Markdown link",
   "text": "[call](tel:+10000000000)",
   "links": [
    {
     "kind": "other",
     "start": 0,
     "end": 24,
     "text": "[call](tel:+10000000000)",
     "target": "tel:+10000000000",
     "label": "call"
    }
   ]
  },
  {
   "name": "line ranges, line:column, trailing colon",
   "text": "lines /home/user/a.go:10-20 and /home/user/b.go:7:3, then /home/user/c.go:",
   "links": [
    {
     "kind": "path",
     "start": 6,
     "end": 27,
     "text": "/home/user/a.go:10-20",
     "target": "/home/user/a.go",
     "line": 10,
     "lineEnd": 20
    },
    {
     "kind": "path",
     "start": 32,
     "end": 51,
     "text": "/home/user/b.go:7:3",
     "target": "/home/user/b.go",
     "line": 7
    },
    {
     "kind": "path",
     "start": 58,
     "end": 73,
     "text": "/home/user/c.go",
     "target": "/home/user/c.go"
    }
   ]
  },
  {
   "name": "inline code that is one whole path",
   "text": "open `/home/user/Projects/demo/main.go:40` now",
   "links": [
    {
     "kind": "path",
     "start": 6,
     "end": 41,
     "text": "/home/user/Projects/demo/main.go:40",
     "target": "/home/user/Projects/demo/main.go",
     "line": 40
    }
   ]
  },
  {
   "name": "inline code with more than a path, relative path in code",
   "text": "not `cat /home/user/x.go` and not `src/main.go`",
   "links": []
  },
  {
   "name": "slash commands, // and one-segment paths are not paths",
   "text": "type /clear or //comment or /tmp",
   "links": []
  },
  {
   "name": "emphasis around paths",
   "text": "**/home/user/x.go** and *~/y.md*",
   "links": [
    {
     "kind": "path",
     "start": 2,
     "end": 17,
     "text": "/home/user/x.go",
     "target": "/home/user/x.go"
    },
    {
     "kind": "path",
     "start": 25,
     "end": 31,
     "text": "~/y.md",
     "target": "~/y.md"
    }
   ]
  },
  {
   "name": "relative paths and anchors are not links",
   "text": "relative src/main.go and [rel](src/main.go) and [anchor](#top)",
   "links": []
  },
  {
   "name": "quillpair is not a link; other schemes; file://localhost",
   "text": "[pair](quillpair:abc) [mail](mailto:user@example.com) [js](javascript:void) <file://localhost/home/user/r.txt>",
   "links": [
    {
     "kind": "other",
     "start": 22,
     "end": 53,
     "text": "[mail](mailto:user@example.com)",
     "target": "mailto:user@example.com",
     "label": "mail"
    },
    {
     "kind": "other",
     "start": 54,
     "end": 75,
     "text": "[js](javascript:void)",
     "target": "javascript:void",
     "label": "js"
    },
    {
     "kind": "file",
     "start": 76,
     "end": 110,
     "text": "<file://localhost/home/user/r.txt>",
     "target": "/home/user/r.txt"
    }
   ]
  },
  {
   "name": "fenced block lines are code",
   "text": "```\n/home/user/in/fence.go\nhttps://x.io/in\n```\nafter /home/user/out/fence.go",
   "links": [
    {
     "kind": "path",
     "start": 53,
     "end": 76,
     "text": "/home/user/out/fence.go",
     "target": "/home/user/out/fence.go"
    }
   ]
  },
  {
   "name": "tilde fence, indented and tab-indented code",
   "text": "~~~go\n/home/user/in/tilde.go\n~~~\n    /home/user/indented/code.go\n\t/home/user/tab/code.go\nok ~/z/w.txt",
   "links": [
    {
     "kind": "path",
     "start": 92,
     "end": 101,
     "text": "~/z/w.txt",
     "target": "~/z/w.txt"
    }
   ]
  },
  {
   "name": "non-ASCII text: ranges count code points",
